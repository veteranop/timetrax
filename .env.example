# TimeTrax local secrets — copy this file to `.env` and fill in.
# `.env` is gitignored and never leaves this machine. Do NOT commit real keys.

# Django secret key (session/cookie signing). Generate your own, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-real-random-value

# Stripe secret key. START WITH YOUR TEST KEY (sk_test_...) so no real invoices go out.
# Find it in Stripe Dashboard → Developers → API keys.
# Switch to sk_live_... only once you've confirmed the flow end-to-end.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Days a client has to pay a sent invoice (net terms).
INVOICE_DAYS_UNTIL_DUE=14

# API key for the /api/ endpoints (Bearer token). Generate any random string.
TIMETRAX_API_KEY=change-me-to-a-real-random-value
